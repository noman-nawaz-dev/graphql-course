{
   "name": "server",
   "version": "1.0.0",
   "description": "",
   "main": "dist/app.js",
   "scripts": {
      "start": "NODE_ENV=production node dist/app.js",
      "build": "rm -rf dist && tsc -p . && cp package.json dist/ && cd dist && npm install --omit=dev --platform=linux --arch=x64",
      "deploy": "npm run build && serverless deploy",
      "dev": "NODE_ENV=development tsx watch src/app.ts",
      "clean": "rimraf dist node_modules",
      "generate": "graphql-codegen",
      "zip": "zip -r server.zip . -x '*.env' 'tests/*' 'tests/**/*'"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "dependencies": {
      "@apollo/server": "^4.11.3",
      "@as-integrations/aws-lambda": "^3.1.0",
      "@graphql-tools/schema": "^9.0.19",
      "@graphql-tools/utils": "^9.2.1",
      "aws-lambda": "^1.0.7",
      "bcryptjs": "^3.0.2",
      "cors": "2.8.5",
      "dotenv": "^16.4.7",
      "express": "4.21.2",
      "graphql": "^16.10.0",
      "graphql-subscriptions": "^3.0.0",
      "graphql-tag": "^2.12.6",
      "graphql-ws": "^6.0.4",
      "helmet": "8.0.0",
      "jsonwebtoken": "^9.0.2",
      "mongoose": "^8.12.1",
      "morgan": "1.10.0",
      "ws": "^8.18.1"
   },
   "devDependencies": {
      "@graphql-codegen/cli": "^5.0.5",
      "@graphql-codegen/typescript": "^4.1.3",
      "@graphql-codegen/typescript-resolvers": "^4.4.2",
      "@types/aws-lambda": "^8.10.147",
      "@types/bcryptjs": "^2.4.6",
      "@types/cors": "2.8.17",
      "@types/express": "4.17.21",
      "@types/helmet": "4.0.0",
      "@types/jsonwebtoken": "^9.0.8",
      "@types/morgan": "1.9.9",
      "@types/node": "22.13.1",
      "serverless-offline": "^14.4.0",
      "tsx": "4.19.2",
      "typescript": "5.7.3"
   }
}
